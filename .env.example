# SHRUTI — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.

# --- Speech-to-text (required for the voice path) ---
# Sarvam AI — Saaras streaming STT. https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Generation, Tier 2 (optional; system degrades to extractive Tier 1 without these) ---
# Cerebras — primary generation provider. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Groq — failover generation provider. https://console.groq.com
GROQ_API_KEY=

# --- Artifact hosting ---
# HF token with write access, used to push/pull corpus artifacts and deploy the Space.
HF_TOKEN=
# Dataset repo holding the prebuilt corpus + embeddings (pulled at Docker build).
SHRUTI_ARTIFACT_REPO=

# --- Runtime tuning (all optional; defaults in app/settings.py) ---
# Embedding lane: "fast" (potion static, default) | "quality" (e5-small ONNX int8)
SHRUTI_EMBED_LANE=fast
# Vector search: "hnsw" (usearch, default) | "exact" (NumPy brute force, for verification)
SHRUTI_SEARCH_MODE=hnsw
# Abstention threshold on top fused score. Calibrated on D3; see docs/CALIBRATION.md.
SHRUTI_SCOPE_TAU=
# Number of warmup queries run at startup before /api/health reports ready.
SHRUTI_WARMUP_QUERIES=20
# Directory holding corpus artifacts inside the container.
SHRUTI_ARTIFACT_DIR=/app/artifacts
